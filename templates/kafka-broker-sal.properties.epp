<%- | String $broker_address,
      String $sasl_username,
      String $sasl_password,
      String $registry_url,
| -%>
# This file is managed by Puppet; changes may be overwritten.
org.lsst.ccs.kafka.bootstrap.url=<%= $broker_address %>
org.lsst.ccs.kafka.registry.url=<%= $registry_url %>
org.lsst.ccs.kafka.security.protocol=SASL_SSL
org.lsst.ccs.kafka.username=<%= $sasl_username %>
org.lsst.ccs.kafka.password=<%= $sasl_password %>
